[Unit]
Description=tpmlsm: only allowlisted binaries may open the TPM
Documentation=https://github.com/bschaatsbergen/tpmlsm
# Start before anything that uses the TPM; a process that is already running
# when tpmlsm loads is denied until it restarts. If a service creates the TPM
# device (swtpm, for example), order this unit after it with a drop-in.
# Enforcement lasts until reboot; stopping this unit does not remove it.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/tpmlsm

[Install]
WantedBy=multi-user.target
